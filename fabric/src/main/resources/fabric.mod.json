{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Horse armor can be enchanted at the enchanting table and the anvil, and its armor enchantments work for the horse that wears it. Only needed on the server.",
  "authors": [
    "Ember Bocor"
  ],
  "contact": {
    "homepage": "https://github.com/emberbocor/horsearmorenchanting",
    "sources": "https://github.com/emberbocor/horsearmorenchanting",
    "issues": "https://github.com/emberbocor/horsearmorenchanting/issues"
  },
  "license": "${mod_license}",
  "environment": "*",
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": "${fabric_loader_version_range}",
    "fabric-api": "${fabric_api_version_range}",
    "minecraft": "${fabric_minecraft_version_range}",
    "java": ">=21"
  }
}
